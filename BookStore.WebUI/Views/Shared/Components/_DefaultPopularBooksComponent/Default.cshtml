@model List<BookStore.DtoLayer.ProductDtos.ResultProductDto>

@{
    // Model'de kitaplar var, kategoriye göre grupla
    var groupedByCategory = Model
        .GroupBy(p => new { p.CategoryId, p.CategoryName })
        .ToList();

    int tabIndex = 0;
}

<section id="popular-books" class="bookshelf py-5 my-5">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="section-header align-center">
						<div class="title">
							<span>Bazı Katiteli Ürünler</span>
                            </div>
						</div>

                <div class="section-header align-center">
                    <h2 class="section-title">Popüler Kitaplarımız</h2>
                </div>

                @if (!groupedByCategory.Any())
                {
                    <p>Henüz kitap bulunmamaktadır.</p>
                }
                else
                {
                    <ul class="nav nav-tabs d-flex justify-content-center" id="bookTab" role="tablist">
                        @foreach (var category in groupedByCategory)
                        {
                            tabIndex++;
                            var categoryName = string.IsNullOrEmpty(category.Key.CategoryName) ? "Kategori Yok" : category.Key.CategoryName;

                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(tabIndex == 1 ? "active" : "")"
                                        id="tab-@category.Key.CategoryId"
                                        data-bs-toggle="tab"
                                        data-bs-target="#category-@category.Key.CategoryId"
                                        type="button"
                                        role="tab"
                                        aria-controls="category-@category.Key.CategoryId"
                                        aria-selected="@(tabIndex == 1 ? "true" : "false")">
                                    @categoryName
                                </button>
                            </li>
                        }
                    </ul>

                    <div class="tab-content mt-4" id="bookTabContent">
                        @{
                            int contentIndex = 0;
                        }
                        @foreach (var category in groupedByCategory)
                        {
                            contentIndex++;
                            <div class="tab-pane fade @(contentIndex == 1 ? "show active" : "")" id="category-@category.Key.CategoryId" role="tabpanel" aria-labelledby="tab-@category.Key.CategoryId">
                                <div class="row">
                                    @foreach (var product in category)
                                    {
                                        <div class="col-md-3 mb-4">
                                            <div class="product-item text-center">
                                                <figure class="product-style">
                                                    <img src="@product.ImageUrl" style="width:200px;height:300px" alt="@product.ProductName" class="product-img" />
                                                    <button type="button" class="add-to-cart btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#modalGetDetails_@product.ProductId">
                                                        İncele
                                                    </button>
                                                </figure>
                                                <figcaption>
                                                    <h3>@product.ProductName</h3>
                                                    <span>@product.AuthorName</span>
                                                    <div class="item-price">₺ @product.ProductPrice</div>
                                                </figcaption>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>


@foreach (var product in Model)
{
    <div class="modal fade" id="modalGetDetails_@product.ProductId" tabindex="-1" aria-labelledby="modalLabel_@product.ProductId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel_@product.ProductId">@product.ProductName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body text-center">
                    <img src="@product.ImageUrl" alt="@product.ProductName" class="img-fluid mb-3" style="max-height: 300px; object-fit: cover;" />
                    <h6 class="text-muted">Author: @product.AuthorName</h6>
                    <p>@product.Description</p>
                    <p><strong>Price:</strong> ₺ @product.ProductPrice</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn btn-primary">Sepete Ekle</button>
                </div>

            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
