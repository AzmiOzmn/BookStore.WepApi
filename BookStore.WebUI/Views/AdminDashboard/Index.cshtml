@using BookStore.EntityLayer.Concrete
@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/AdminLayout/AdminLayout.cshtml";

    var mostExpensiveBooks = (List<Product>)ViewBag.MostExpensiveBooks;
    var cheapestBooks = (List<Product>)ViewBag.CheapestBooks;

    // En pahalı ve en ucuz kitap isimleri (ilk kitapların adı)
    string mostExpensiveBookName = mostExpensiveBooks.Any() ? mostExpensiveBooks.First().ProductName : "Yok";
    string cheapestBookName = cheapestBooks.Any() ? cheapestBooks.First().ProductName : "Yok";
}

<div class="container mt-4">

    <!-- Üst satır: 4 eşit kart (col-md-3) -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h5 class="card-title">Toplam Kitap Sayısı</h5>
                    <p class="card-text fs-3">@ViewBag.BookCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h5 class="card-title">Toplam Yazar Sayısı</h5>
                    <p class="card-text fs-3">@ViewBag.AuthorCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h5 class="card-title">Toplam Kategori Sayısı</h5>
                    <p class="card-text fs-3">@ViewBag.CategoryCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-danger h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h5 class="card-title">En Pahalı Kitap</h5>
                    <p class="card-text fs-5">@mostExpensiveBookName</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alt satır: 4 eşit kart (col-md-3) -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h5 class="card-title">En Ucuz Kitap</h5>
                    <p class="card-text fs-5">@cheapestBookName</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h5 class="card-title">Abone Sayısı</h5>
                    <p class="card-text fs-3">@ViewBag.SubscriberCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card h-100" style="background-color: #121212; color: white;">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center" style="height: 100%;">
                    <h5 class="card-title fw-bold mb-3" style="color: white;">Günün Sözü</h5>
                    <p class="card-text fs-6">@ViewBag.QuoteOfTheDay</p>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mt-4">En Pahalı Kitaplar</h3>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Kitap Adı</th>
                <th>Fiyat</th>
                <th>Yazar</th>
                <th>Kategori</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in mostExpensiveBooks)
            {
                <tr>
                    <td>@book.ProductName</td>
                    <td>@book.ProductPrice.ToString("C")</td>
                    <td>@(!string.IsNullOrWhiteSpace(book.Author?.Name) ? book.Author.Name : "Bilinmiyor")</td>
                    <td>@(!string.IsNullOrWhiteSpace(book.Category?.CategoryName) ? book.Category.CategoryName : "Bilinmiyor")</td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="mt-4">En Ucuz Kitaplar</h3>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Kitap Adı</th>
                <th>Fiyat</th>
                <th>Yazar</th>
                <th>Kategori</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in cheapestBooks)
            {
                <tr>
                    <td>@book.ProductName</td>
                    <td>@book.ProductPrice.ToString("C")</td>
                    <td>@(!string.IsNullOrWhiteSpace(book.Author?.Name) ? book.Author.Name : "Bilinmiyor")</td>
                    <td>@(!string.IsNullOrWhiteSpace(book.Category?.CategoryName) ? book.Category.CategoryName : "Bilinmiyor")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
